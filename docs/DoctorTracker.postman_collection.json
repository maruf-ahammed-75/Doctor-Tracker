                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"age\": 45,\n  \"gender\": \"male\",\n  \"condition\": \"Hypertension\",\n  \"phone\": \"+1-555-1234\",\n  \"email\": \"john.doe@example.com\",\n  \"visitDate\": \"2026-09-24\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}", "patients"]
            },
            "description": "Add a new patient under the specified doctor."
          },
          "response": []
        },
        {
          "name": "Remove Patient from Doctor",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/patients/{{patientId}}",
