              "raw": "{\n  \"hospital\": \"Metro Advanced Cardiac Institute\",\n  \"phone\": \"+1-555-9999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}"]
