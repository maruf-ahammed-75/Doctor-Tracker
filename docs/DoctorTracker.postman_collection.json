{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a5b-9c8d-7e6f5a4b3c2d",
    "name": "Doctor Tracker API",
    "description": "Production-ready Postman collection for the Doctor Tracker REST API backend. Covers Auth, Doctors, Patients, and Dashboard analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonResponse = pm.response.json();",
                  "    if (jsonResponse.data && jsonResponse.data.token) {",
                  "        pm.environment.set(\"token\", jsonResponse.data.token);",
                  "        console.log(\"✅ Token successfully saved to {{token}} environment variable!\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@doctortracker.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate admin user and automatically persist the JWT into the {{token}} environment variable."
          },
          "response": []
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Fetch current authenticated admin user profile (password excluded)."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Clear session and invalidate httpOnly auth cookie."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Create Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data._id) {",
                  "        pm.environment.set(\"doctorId\", json.data._id);",
                  "        console.log(\"Saved doctorId:\", json.data._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Sarah Connor\",\n  \"specialization\": \"Cardiology\",\n  \"hospital\": \"Metro General Hospital\",\n  \"phone\": \"+1-555-0101\",\n  \"email\": \"sarah.connor@metrohospital.org\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors",
              "host": ["{{baseUrl}}"],
              "path": ["doctors"]
            },
            "description": "Create a new doctor document. Creator admin is automatically attached."
          },
          "response": []
        },
        {
          "name": "List Doctors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/doctors?page=1&limit=10&search=&specialization=&from=&to=",
              "host": ["{{baseUrl}}"],
              "path": ["doctors"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (defaults to 1)",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (max 100)",
                  "disabled": false
                },
                {
                  "key": "search",
                  "value": "Cardiology",
                  "description": "Full-text search on name, specialization, hospital",
                  "disabled": true
                },
                {
                  "key": "specialization",
                  "value": "Cardiology",
                  "description": "Exact specialization filter",
                  "disabled": true
                },
                {
                  "key": "from",
                  "value": "2026-01-01",
                  "description": "Start date for createdAt filter (YYYY-MM-DD)",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "2026-12-31",
                  "description": "End date for createdAt filter (YYYY-MM-DD)",
                  "disabled": true
                }
              ]
            },
            "description": "List all doctors with text search, specialization filtering, date ranges, and pagination."
          },
          "response": []
        },
        {
