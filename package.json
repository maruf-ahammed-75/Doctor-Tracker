{
  "name": "doctor-tracker-backend",
  "version": "1.0.0",
  "description": "Doctor Tracker REST API backend built with Node.js, Express, and MongoDB Atlas",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --watch .env src/server.js",
    "dev:frontend": "npm --prefix doctor-tracker-frontend run dev",
    "seed:admin": "node src/seed/createAdmin.js",
    "verify:indexes": "node src/scripts/verifyIndexes.js"
  },
  "keywords": [
    "doctor-tracker",
    "express",
    "mongodb",
    "mongoose",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
